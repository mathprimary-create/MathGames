<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Number Ordering Game</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
body {
    font-family: Arial, sans-serif;
    text-align: center;
    background: linear-gradient(to right, #ffecd2, #fcb69f);
    margin: 0;
    padding: 20px;
}

h1 {
    color: #333;
}

#game {
    max-width: 500px;
    margin: auto;
}

.box-container {
    display: flex;
    justify-content: center;
    margin: 20px 0;
    flex-wrap: wrap;
}

.box {
    width: 60px;
    height: 60px;
    border: 2px dashed #555;
    margin: 10px;
    line-height: 60px;
    font-size: 20px;
    background: #fff;
    border-radius: 10px;
}

.number {
    display: inline-block;
    padding: 15px;
    margin: 10px;
    background: #4caf50;
    color: white;
    border-radius: 10px;
    cursor: grab;
    font-size: 18px;
}

#message {
    font-size: 22px;
    margin-top: 10px;
}

#restart {
    display: none;
    padding: 10px 20px;
    font-size: 18px;
    margin-top: 20px;
}

#volumeControl {
    margin-top: 10px;
}

canvas {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
}
</style>
</head>

<body>

<h1>🎲 Number Ordering Game</h1>
<p id="instruction"></p>

<div id="game">
    <div class="box-container" id="dropZone"></div>
    <div id="numbers"></div>
    <div id="message"></div>
</div>

<input type="range" id="volumeControl" min="0" max="1" step="0.1" value="1">

<button id="restart" onclick="startGame()">Restart Game</button>

<canvas id="confetti"></canvas>

<audio id="correctSound" src="correct.mp3"></audio>
<audio id="wrongSound" src="wrong.mp3"></audio>

<script>
let questions = [];
let currentQ = 0;
let answer = [];
let attempts = 0;

const correctSound = document.getElementById("correctSound");
const wrongSound = document.getElementById("wrongSound");
const volumeControl = document.getElementById("volumeControl");

volumeControl.addEventListener("input", () => {
    correctSound.volume = volumeControl.value;
    wrongSound.volume = volumeControl.value;
});

function generateQuestions() {
    questions = [];
    for (let i = 0; i < 10; i++) {
        let nums = [];
        while (nums.length < 4) {
            let n = Math.floor(Math.random() * 500) + 1;
            if (!nums.includes(n)) nums.push(n);
        }

        let type = Math.random() > 0.5 ? "asc" : "desc";
        let sorted = [...nums].sort((a,b)=> a-b);
        if (type === "desc") sorted.reverse();

        questions.push({nums, sorted, type});
    }
}

function loadQuestion() {
    if (currentQ >= questions.length) {
        document.getElementById("restart").style.display = "block";
        document.getElementById("instruction").innerText = "🎉 Game Over!";
        return;
    }

    const q = questions[currentQ];
    answer = [];
    attempts = 0;

    document.getElementById("instruction").innerText =
        q.type === "asc" ? "Arrange in ASCENDING order" : "Arrange in DESCENDING order";

    const dropZone = document.getElementById("dropZone");
    dropZone.innerHTML = "";

    for (let i = 0; i < q.nums.length; i++) {
        let box = document.createElement("div");
        box.className = "box";
        box.dataset.index = i;

        box.ondragover = (e) => e.preventDefault();
        box.ondrop = drop;

        dropZone.appendChild(box);
    }

    const numbersDiv = document.getElementById("numbers");
    numbersDiv.innerHTML = "";

    shuffle(q.nums).forEach(num => {
        let el = document.createElement("div");
        el.className = "number";
        el.innerText = num;
        el.draggable = true;

        el.ondragstart = drag;

        numbersDiv.appendChild(el);
    });

    document.getElementById("message").innerText = "";
}

function drag(e) {
    e.dataTransfer.setData("text", e.target.innerText);
}

function drop(e) {
    e.preventDefault();
    let data = e.dataTransfer.getData("text");
    e.target.innerText = data;
    answer[e.target.dataset.index] = Number(data);

    if (answer.filter(x => x !== undefined).length === 4) {
        checkAnswer();
    }
}

function checkAnswer() {
    let correct = JSON.stringify(answer) === JSON.stringify(questions[currentQ].sorted);

    if (correct) {
        correctSound.play();
        showConfetti();
        document.getElementById("message").innerText = "✅ Correct!";
        
        setTimeout(() => {
            currentQ++;
            loadQuestion();
        }, 1500);

    } else {
        attempts++;

        if (attempts === 1) {
            wrongSound.play();
            document.getElementById("message").innerText = "❌ Try Again!";

            // Clear boxes for retry
            document.querySelectorAll(".box").forEach(box => box.innerText = "");
            answer = [];

        } else {
            wrongSound.play();
            document.getElementById("message").innerText =
                "❌ Correct answer: " + questions[currentQ].sorted.join(", ");

            setTimeout(() => {
                currentQ++;
                loadQuestion();
            }, 2000);
        }
    }
}

function shuffle(arr) {
    return arr.sort(() => Math.random() - 0.5);
}

function startGame() {
    currentQ = 0;
    document.getElementById("restart").style.display = "none";
    generateQuestions();
    loadQuestion();
}

startGame();


// 🎉 Confetti
const canvas = document.getElementById("confetti");
const ctx = canvas.getContext("2d");

canvas.width = window.innerWidth;
canvas.height = window.innerHeight;

function showConfetti() {
    for (let i = 0; i < 100; i++) {
        let x = Math.random() * canvas.width;
        let y = Math.random() * canvas.height;
        ctx.fillStyle = "hsl(" + Math.random()*360 + ",100%,50%)";
        ctx.fillRect(x, y, 5, 5);
    }
    setTimeout(()=>ctx.clearRect(0,0,canvas.width,canvas.height),500);
}
</script>

</body>
</html>
