<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Simrit's Mango Orchard Game</title>
  <style>
    :root {
      --sky1: #87d8ff;
      --sky2: #dff7ff;
      --grass: #8bd36c;
      --leaf: #3fa34d;
      --leaf-dark: #2d7a38;
      --brown: #8a5a2b;
      --yellow: #ffd84d;
      --yellow-dark: #f1b600;
      --green-mango: #66bb55;
      --basket: #c68642;
      --basket-dark: #8d5a2b;
      --card: rgba(255,255,255,0.9);
      --text: #213547;
      --shadow: 0 10px 30px rgba(0,0,0,0.12);
      --danger: #d94b4b;
      --success: #168f4e;
      --accent: #ff7f50;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: "Trebuchet MS", "Comic Sans MS", Arial, sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at 20% 20%, rgba(255,255,255,0.75) 0 50px, transparent 51px),
        radial-gradient(circle at 80% 15%, rgba(255,255,255,0.7) 0 45px, transparent 46px),
        linear-gradient(to bottom, var(--sky1), var(--sky2) 55%, #d7f7c8 55%, var(--grass) 100%);
      min-height: 100vh;
      overflow-x: hidden;
    }

    .game-shell {
      max-width: 980px;
      margin: 0 auto;
      padding: 14px;
    }

    .top-bar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 12px;
      align-items: center;
      background: var(--card);
      border-radius: 22px;
      padding: 14px 16px;
      box-shadow: var(--shadow);
      margin-bottom: 14px;
    }

    .title-wrap h1 {
      margin: 0;
      font-size: clamp(1.5rem, 3.8vw, 2.3rem);
      color: #dd5c1d;
    }

    .title-wrap p {
      margin: 6px 0 0;
      font-size: 1rem;
    }

    .controls {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .volume-box, .score-box {
      background: #fff7cf;
      border-radius: 16px;
      padding: 10px 12px;
      font-weight: 700;
      box-shadow: inset 0 0 0 2px rgba(0,0,0,0.05);
    }

    .volume-box label {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.95rem;
    }

    input[type="range"] {
      width: 140px;
      accent-color: #ff9900;
    }

    .story-box {
      background: rgba(255,255,255,0.94);
      border-radius: 22px;
      padding: 16px;
      box-shadow: var(--shadow);
      margin-bottom: 14px;
      border: 4px dashed #ffd166;
    }

    .story-box p {
      margin: 0;
      font-size: clamp(1rem, 2.4vw, 1.1rem);
      line-height: 1.5;
    }

    .game-area {
      position: relative;
      background: linear-gradient(to bottom, #d7f5ff, #edfff0 55%, #92db6a 55%, #74c14f);
      min-height: 620px;
      border-radius: 30px;
      box-shadow: var(--shadow);
      overflow: hidden;
      border: 5px solid rgba(255,255,255,0.55);
    }

    .sun {
      position: absolute;
      top: 24px;
      right: 24px;
      width: 84px;
      height: 84px;
      border-radius: 50%;
      background: radial-gradient(circle, #fff7b2 0%, #ffd54a 65%, #ffb300 100%);
      box-shadow: 0 0 30px rgba(255, 210, 77, 0.8);
    }

    .hill {
      position: absolute;
      bottom: 120px;
      background: #82cb60;
      border-radius: 50%;
      filter: brightness(0.98);
    }

    .hill1 { left: -40px; width: 280px; height: 140px; }
    .hill2 { left: 180px; width: 360px; height: 170px; }
    .hill3 { right: -40px; width: 300px; height: 150px; }

    .question-banner {
      position: absolute;
      top: 16px;
      left: 16px;
      right: 120px;
      background: rgba(255,255,255,0.95);
      border-radius: 20px;
      padding: 14px 16px;
      box-shadow: var(--shadow);
      z-index: 3;
    }

    .question-banner h2 {
      margin: 0 0 6px;
      font-size: clamp(1.15rem, 3vw, 1.6rem);
      color: #d56717;
    }

    .question-banner p {
      margin: 0;
      font-size: clamp(1rem, 2.3vw, 1.1rem);
    }

    .message {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      top: 108px;
      width: min(92%, 520px);
      text-align: center;
      padding: 12px 14px;
      border-radius: 18px;
      background: rgba(255,255,255,0.97);
      box-shadow: var(--shadow);
      font-size: clamp(1rem, 2.5vw, 1.15rem);
      font-weight: 700;
      z-index: 4;
      min-height: 52px;
    }

    .message.success { color: var(--success); }
    .message.error { color: var(--danger); }
    .message.info { color: #7a5d00; }

    .orchard {
      position: absolute;
      inset: 0;
    }

    .tree {
      position: absolute;
      left: 50%;
      bottom: 125px;
      transform: translateX(-50%);
      width: min(70vw, 390px);
      height: min(72vw, 420px);
      z-index: 2;
    }

    .trunk {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 88px;
      height: 220px;
      background: linear-gradient(to right, #7c471f, #9c6631, #7b481f);
      border-radius: 30px;
      box-shadow: inset -8px 0 0 rgba(0,0,0,0.1);
    }

    .canopy {
      position: absolute;
      top: 34px;
      left: 50%;
      transform: translateX(-50%);
      width: 320px;
      height: 240px;
      background: radial-gradient(circle at 40% 35%, #57c266 0 30%, #3fa34d 31% 60%, #2d7a38 61% 100%);
      border-radius: 48% 52% 50% 50%;
      box-shadow:
        -110px 38px 0 10px #3fa34d,
        110px 40px 0 10px #3fa34d,
        -65px -25px 0 15px #57c266,
        70px -24px 0 15px #57c266;
    }

    .girl {
      position: absolute;
      left: 7%;
      bottom: 110px;
      width: 150px;
      height: 230px;
      z-index: 2;
    }

    .girl .head {
      width: 68px;
      height: 68px;
      background: #ffd9b3;
      border-radius: 50%;
      position: absolute;
      left: 40px;
      top: 0;
      border: 3px solid rgba(0,0,0,0.08);
    }

    .girl .hair {
      width: 78px;
      height: 50px;
      background: #3e2520;
      border-radius: 50px 50px 25px 25px;
      position: absolute;
      left: 35px;
      top: -6px;
    }

    .girl .body {
      position: absolute;
      top: 62px;
      left: 28px;
      width: 95px;
      height: 95px;
      background: #ff7ab6;
      border-radius: 22px 22px 18px 18px;
    }

    .girl .arm, .girl .leg {
      position: absolute;
      background: #ffd9b3;
      border-radius: 20px;
    }

    .girl .arm.left { width: 18px; height: 75px; top: 74px; left: 15px; transform: rotate(25deg); }
    .girl .arm.right { width: 18px; height: 82px; top: 74px; right: 12px; transform: rotate(-18deg); }
    .girl .leg.left { width: 20px; height: 90px; top: 150px; left: 46px; }
    .girl .leg.right { width: 20px; height: 90px; top: 150px; left: 82px; }
    .girl .shoe { position: absolute; width: 36px; height: 16px; background: #5c2e91; border-radius: 20px; bottom: 0; }
    .girl .shoe.left { left: 38px; }
    .girl .shoe.right { left: 76px; }

    .basket {
      position: absolute;
      right: 8%;
      bottom: 82px;
      width: 170px;
      height: 96px;
      z-index: 3;
    }

    .basket .rim {
      position: absolute;
      bottom: 58px;
      left: 10px;
      width: 150px;
      height: 18px;
      background: #d99952;
      border-radius: 18px;
      border: 3px solid var(--basket-dark);
    }

    .basket .body {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 170px;
      height: 75px;
      background: linear-gradient(to bottom, #dca15b, #b26e31);
      clip-path: polygon(8% 0, 92% 0, 100% 100%, 0 100%);
      border: 4px solid var(--basket-dark);
      border-top: none;
      border-radius: 0 0 18px 18px;
    }

    .basket .handle {
      position: absolute;
      left: 35px;
      bottom: 56px;
      width: 100px;
      height: 56px;
      border: 8px solid var(--basket-dark);
      border-bottom: none;
      border-radius: 80px 80px 0 0;
      opacity: 0.85;
    }

    .basket-fruits {
      position: absolute;
      left: 20px;
      bottom: 18px;
      width: 130px;
      height: 55px;
      pointer-events: none;
    }

    .basket-mango {
      position: absolute;
      width: 28px;
      height: 38px;
      background: linear-gradient(145deg, #ffe669, #f7bd00);
      border-radius: 50% 45% 55% 50% / 42% 50% 50% 58%;
      border: 2px solid rgba(0,0,0,0.08);
      transform: rotate(22deg);
      box-shadow: 0 2px 0 rgba(0,0,0,0.07);
    }

    .mangoes-layer {
      position: absolute;
      inset: 0;
      z-index: 5;
    }

    .mango-btn {
      position: absolute;
      width: 82px;
      height: 98px;
      border: none;
      cursor: pointer;
      background: transparent;
      padding: 0;
      transition: transform 0.2s ease;
      touch-action: manipulation;
    }

    .mango-btn:hover,
    .mango-btn:focus-visible {
      transform: scale(1.06);
      outline: none;
    }

    .mango-shape {
      position: absolute;
      inset: 8px 12px 18px;
      background: linear-gradient(145deg, #fff191 0%, var(--yellow) 48%, var(--yellow-dark) 100%);
      border-radius: 52% 44% 54% 47% / 36% 42% 58% 64%;
      box-shadow: inset -10px -8px 0 rgba(220,150,0,0.16);
      border: 3px solid rgba(0,0,0,0.08);
    }

    .mango-shape::before {
      content: "";
      position: absolute;
      top: -12px;
      left: 50%;
      width: 4px;
      height: 18px;
      background: #7f521f;
      transform: translateX(-50%) rotate(12deg);
      border-radius: 4px;
    }

    .mango-shape::after {
      content: "";
      position: absolute;
      top: -8px;
      left: calc(50% + 5px);
      width: 18px;
      height: 10px;
      background: #48a95c;
      border-radius: 50% 0 50% 50%;
      transform: rotate(-14deg);
    }

    .mango-number {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      font-size: 1.8rem;
      font-weight: 900;
      color: #713b00;
      text-shadow: 1px 1px 0 rgba(255,255,255,0.4);
      padding-top: 8px;
    }

    .mango-btn.wrong .mango-shape {
      background: linear-gradient(145deg, #95e37d 0%, var(--green-mango) 55%, #389b42 100%);
    }

    .mango-btn.correct {
      animation: fallToBasket 1s forwards ease-in;
      pointer-events: none;
      z-index: 10;
    }

    .mango-btn.hidden {
      visibility: hidden;
      pointer-events: none;
    }

    @keyframes fallToBasket {
      0% { transform: translate(0, 0) scale(1) rotate(0deg); opacity: 1; }
      60% { opacity: 1; }
      100% {
        transform: translate(var(--fall-x), var(--fall-y)) scale(0.5) rotate(240deg);
        opacity: 0;
      }
    }

    .progress-wrap {
      margin-top: 14px;
      background: rgba(255,255,255,0.95);
      border-radius: 18px;
      padding: 12px;
      box-shadow: var(--shadow);
    }

    .progress-label {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      font-weight: 800;
      margin-bottom: 8px;
      flex-wrap: wrap;
    }

    .progress-bar {
      height: 18px;
      background: #e9ecef;
      border-radius: 999px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(to right, #ffb703, #ff7f50);
      border-radius: 999px;
      transition: width 0.35s ease;
    }

    .finish-card {
      display: none;
      margin-top: 16px;
      background: rgba(255,255,255,0.97);
      border-radius: 24px;
      box-shadow: var(--shadow);
      padding: 20px;
      text-align: center;
      border: 4px solid #ffd166;
    }

    .finish-card.show { display: block; }

    .finish-card h3 {
      margin: 0 0 10px;
      font-size: clamp(1.4rem, 3.3vw, 2rem);
      color: #d56717;
    }

    .finish-card p {
      margin: 0 0 18px;
      font-size: 1.08rem;
      font-weight: 700;
    }

    .restart-btn {
      appearance: none;
      border: none;
      background: linear-gradient(to bottom, #ff9f1c, #ff7f11);
      color: white;
      font-size: 1.05rem;
      font-weight: 900;
      padding: 14px 24px;
      border-radius: 999px;
      cursor: pointer;
      box-shadow: 0 8px 20px rgba(255,127,17,0.35);
      transition: transform 0.2s ease;
    }

    .restart-btn:hover,
    .restart-btn:focus-visible {
      transform: translateY(-2px) scale(1.02);
      outline: none;
    }

    #confettiCanvas {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 999;
    }

    @media (max-width: 900px) {
      .tree {
        width: 320px;
        height: 390px;
      }
      .canopy {
        width: 250px;
        height: 205px;
        box-shadow:
          -85px 32px 0 8px #3fa34d,
          85px 32px 0 8px #3fa34d,
          -55px -18px 0 11px #57c266,
          55px -18px 0 11px #57c266;
      }
      .girl {
        left: 3%;
        transform: scale(0.9);
        transform-origin: bottom left;
      }
      .basket {
        right: 3%;
        transform: scale(0.9);
        transform-origin: bottom right;
      }
      .question-banner { right: 110px; }
    }

    @media (max-width: 700px) {
      .game-area {
        min-height: 700px;
      }
      .question-banner {
        right: 16px;
      }
      .message {
        top: 132px;
      }
      .tree {
        left: 54%;
        bottom: 175px;
        width: 280px;
        height: 350px;
      }
      .canopy {
        width: 220px;
        height: 188px;
      }
      .girl {
        left: 4%;
        bottom: 116px;
        transform: scale(0.78);
      }
      .basket {
        left: 50%;
        right: auto;
        bottom: 70px;
        transform: translateX(-50%) scale(0.95);
      }
      .hill1 { bottom: 165px; }
      .hill2 { bottom: 150px; }
      .hill3 { bottom: 162px; }
      input[type="range"] { width: 120px; }
    }

    @media (max-width: 480px) {
      .game-shell { padding: 10px; }
      .top-bar, .story-box, .progress-wrap, .finish-card { border-radius: 18px; }
      .game-area { min-height: 720px; border-radius: 22px; }
      .sun { width: 62px; height: 62px; top: 16px; right: 16px; }
      .question-banner {
        top: 12px;
        left: 12px;
        right: 12px;
        padding: 12px;
      }
      .message {
        top: 135px;
        width: calc(100% - 24px);
        font-size: 0.98rem;
      }
      .tree {
        left: 55%;
        width: 245px;
        height: 320px;
      }
      .trunk { width: 70px; height: 185px; }
      .canopy {
        width: 180px;
        height: 165px;
        box-shadow:
          -64px 24px 0 7px #3fa34d,
          64px 24px 0 7px #3fa34d,
          -40px -14px 0 8px #57c266,
          40px -14px 0 8px #57c266;
      }
      .mango-btn { width: 68px; height: 85px; }
      .mango-number { font-size: 1.5rem; }
      .girl {
        left: -2%;
        transform: scale(0.66);
      }
      .basket {
        width: 150px;
      }
      .basket .rim { width: 130px; }
      .basket .body { width: 150px; }
      .basket .handle { width: 88px; left: 31px; }
      .basket-fruits { width: 118px; left: 16px; }
      .volume-box label {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>
<body>
  <canvas id="confettiCanvas"></canvas>

  <div class="game-shell">
    <div class="top-bar">
      <div class="title-wrap">
        <h1>🥭 Simrit's Mango Orchard</h1>
        <p>Tap the mango with the <strong>greatest number</strong> to help Simrit pick the ripest one.</p>
      </div>
      <div class="controls">
        <div class="score-box">⭐ Score: <span id="score">0</span></div>
        <div class="volume-box">
          <label>
            🔊 Sound
            <input id="volumeControl" type="range" min="0" max="100" value="85" />
          </label>
        </div>
      </div>
    </div>

    <div class="story-box">
      <p>
        It is summer, and Simrit is excited because she can eat her favourite fruit — <strong>mangoes</strong>!
        There is a big mango tree in her orchard, but Simrit does not know how to pick the ripest mango.
        <strong>Hint:</strong> The mango with the <strong>greatest number</strong> is the ripest.
        Help Simrit fill her basket with ripe, yellow mangoes!
      </p>
    </div>

    <div class="game-area">
      <div class="sun"></div>
      <div class="hill hill1"></div>
      <div class="hill hill2"></div>
      <div class="hill hill3"></div>

      <div class="question-banner">
        <h2 id="questionTitle">Question 1 of 10</h2>
        <p id="questionText">Which mango has the greatest number?</p>
      </div>

      <div id="message" class="message info">Tap a yellow mango to begin!</div>

      <div class="orchard">
        <div class="tree">
          <div class="canopy"></div>
          <div class="trunk"></div>
        </div>

        <div class="girl" aria-hidden="true">
          <div class="hair"></div>
          <div class="head"></div>
          <div class="body"></div>
          <div class="arm left"></div>
          <div class="arm right"></div>
          <div class="leg left"></div>
          <div class="leg right"></div>
          <div class="shoe left"></div>
          <div class="shoe right"></div>
        </div>

        <div class="basket" id="basket" aria-hidden="true">
          <div class="handle"></div>
          <div class="rim"></div>
          <div class="body"></div>
          <div class="basket-fruits" id="basketFruits"></div>
        </div>

        <div class="mangoes-layer" id="mangoesLayer"></div>
      </div>
    </div>

    <div class="progress-wrap">
      <div class="progress-label">
        <span>Progress</span>
        <span id="progressText">0 / 10 questions completed</span>
      </div>
      <div class="progress-bar">
        <div id="progressFill" class="progress-fill"></div>
      </div>
    </div>

    <div id="finishCard" class="finish-card">
      <h3>🎉 Orchard Complete!</h3>
      <p id="finalScoreText">Simrit picked 0 ripe mangoes!</p>
      <button id="restartBtn" class="restart-btn">Play Again</button>
    </div>
  </div>

  <script>
    const TOTAL_QUESTIONS = 10;
    const mangoesLayer = document.getElementById('mangoesLayer');
    const basket = document.getElementById('basket');
    const basketFruits = document.getElementById('basketFruits');
    const questionTitle = document.getElementById('questionTitle');
    const questionText = document.getElementById('questionText');
    const messageEl = document.getElementById('message');
    const scoreEl = document.getElementById('score');
    const progressText = document.getElementById('progressText');
    const progressFill = document.getElementById('progressFill');
    const finishCard = document.getElementById('finishCard');
    const finalScoreText = document.getElementById('finalScoreText');
    const restartBtn = document.getElementById('restartBtn');
    const volumeControl = document.getElementById('volumeControl');
    const confettiCanvas = document.getElementById('confettiCanvas');
    const ctx = confettiCanvas.getContext('2d');

    let questions = [];
    let currentQuestionIndex = 0;
    let score = 0;
    let canAnswer = true;
    let audioContext = null;
    let masterVolume = 0.85;
    let confettiPieces = [];
    let confettiAnimating = false;

    const mangoPositions = [
      { left: '31%', top: '29%' },
      { left: '52%', top: '19%' },
      { left: '64%', top: '40%' }
    ];

    function resizeCanvas() {
      confettiCanvas.width = window.innerWidth;
      confettiCanvas.height = window.innerHeight;
    }

    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    function shuffle(array) {
      const arr = [...array];
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    function randInt(min, max) {
      return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    function createQuestion() {
      const correct = randInt(0, 99);
      const offsets = new Set();

      while (offsets.size < 2) {
        const diff = randInt(1, 25);
        offsets.add(diff);
      }

      const wrongs = [...offsets].map(diff => {
        let value = correct - diff;
        if (value < 0) value = randInt(0, Math.max(0, correct - 1));
        return value;
      });

      const values = shuffle([correct, ...wrongs]);
      return {
        values,
        correct,
        prompt: 'Which mango has the greatest number?'
      };
    }

    function generateQuestions(total = TOTAL_QUESTIONS) {
      const list = [];
      const seen = new Set();

      while (list.length < total) {
        const q = createQuestion();
        const key = q.values.slice().sort((a, b) => a - b).join('-');
        if (!seen.has(key)) {
          seen.add(key);
          list.push(q);
        }
      }

      return shuffle(list);
    }

    function updateVolume() {
      masterVolume = Number(volumeControl.value) / 100;
    }

    volumeControl.addEventListener('input', updateVolume);
    updateVolume();

    function ensureAudio() {
      if (!audioContext) {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        audioContext = new AudioCtx();
      }
      if (audioContext.state === 'suspended') {
        audioContext.resume();
      }
    }

    function playToneSequence(tones) {
      ensureAudio();
      const start = audioContext.currentTime;

      tones.forEach((tone, index) => {
        const osc = audioContext.createOscillator();
        const gain = audioContext.createGain();
        osc.type = tone.type || 'sine';
        osc.frequency.value = tone.freq;

        const segmentStart = start + tone.time;
        const vol = Math.min(1, masterVolume * (tone.volume ?? 0.9));

        gain.gain.setValueAtTime(0.0001, segmentStart);
        gain.gain.exponentialRampToValueAtTime(Math.max(0.0001, vol), segmentStart + 0.01);
        gain.gain.exponentialRampToValueAtTime(0.0001, segmentStart + tone.duration);

        osc.connect(gain);
        gain.connect(audioContext.destination);
        osc.start(segmentStart);
        osc.stop(segmentStart + tone.duration + 0.03);
      });
    }

    function playCorrectSound() {
      playToneSequence([
        { freq: 523.25, duration: 0.12, time: 0, type: 'triangle', volume: 1 },
        { freq: 659.25, duration: 0.12, time: 0.13, type: 'triangle', volume: 1 },
        { freq: 783.99, duration: 0.18, time: 0.27, type: 'triangle', volume: 1 }
      ]);
    }

    function playWrongSound() {
      playToneSequence([
        { freq: 220, duration: 0.12, time: 0, type: 'sawtooth', volume: 0.95 },
        { freq: 170, duration: 0.16, time: 0.11, type: 'sawtooth', volume: 0.95 }
      ]);
    }

    function setMessage(text, type = 'info') {
      messageEl.textContent = text;
      messageEl.className = 'message ' + type;
    }

    function updateHeader() {
      questionTitle.textContent = `Question ${currentQuestionIndex + 1} of ${TOTAL_QUESTIONS}`;
      questionText.textContent = questions[currentQuestionIndex]?.prompt || 'Which mango has the greatest number?';
      scoreEl.textContent = score;
      progressText.textContent = `${currentQuestionIndex} / ${TOTAL_QUESTIONS} questions completed`;
      progressFill.style.width = `${(currentQuestionIndex / TOTAL_QUESTIONS) * 100}%`;
    }

    function addBasketMango() {
      const mango = document.createElement('div');
      mango.className = 'basket-mango';
      mango.style.left = `${randInt(0, 95)}px`;
      mango.style.top = `${randInt(8, 20)}px`;
      mango.style.transform = `rotate(${randInt(-25, 25)}deg)`;
      basketFruits.appendChild(mango);
    }

    function clearMangoes() {
      mangoesLayer.innerHTML = '';
    }

    function renderQuestion() {
      clearMangoes();
      updateHeader();
      canAnswer = true;
      const question = questions[currentQuestionIndex];
      const positions = shuffle(mangoPositions);

      question.values.forEach((value, index) => {
        const btn = document.createElement('button');
        btn.className = 'mango-btn';
        btn.style.left = positions[index].left;
        btn.style.top = positions[index].top;
        btn.setAttribute('aria-label', `Mango number ${value}`);

        const shape = document.createElement('div');
        shape.className = 'mango-shape';

        const number = document.createElement('div');
        number.className = 'mango-number';
        number.textContent = value;

        btn.appendChild(shape);
        btn.appendChild(number);

        btn.addEventListener('click', () => handleAnswer(btn, value));
        mangoesLayer.appendChild(btn);
      });
    }

    function getFallDistance(btn) {
      const btnRect = btn.getBoundingClientRect();
      const basketRect = basket.getBoundingClientRect();
      const startX = btnRect.left + btnRect.width / 2;
      const startY = btnRect.top + btnRect.height / 2;
      const endX = basketRect.left + basketRect.width / 2;
      const endY = basketRect.top + basketRect.height / 2;
      return {
        x: endX - startX,
        y: endY - startY
      };
    }

    function throwConfetti(count = 70) {
      resizeCanvas();
      const colors = ['#ff595e', '#ffca3a', '#8ac926', '#1982c4', '#6a4c93', '#ff924c'];

      for (let i = 0; i < count; i++) {
        confettiPieces.push({
          x: Math.random() * confettiCanvas.width,
          y: -20 - Math.random() * confettiCanvas.height * 0.3,
          w: 6 + Math.random() * 8,
          h: 8 + Math.random() * 12,
          speedY: 2 + Math.random() * 5,
          speedX: -2 + Math.random() * 4,
          color: colors[Math.floor(Math.random() * colors.length)],
          rotation: Math.random() * Math.PI,
          rotationSpeed: -0.2 + Math.random() * 0.4,
          alpha: 0.9 + Math.random() * 0.1
        });
      }

      if (!confettiAnimating) animateConfetti();
    }

    function animateConfetti() {
      confettiAnimating = true;
      ctx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);

      confettiPieces.forEach(piece => {
        piece.x += piece.speedX;
        piece.y += piece.speedY;
        piece.rotation += piece.rotationSpeed;
        piece.speedY += 0.03;

        ctx.save();
        ctx.globalAlpha = piece.alpha;
        ctx.translate(piece.x, piece.y);
        ctx.rotate(piece.rotation);
        ctx.fillStyle = piece.color;
        ctx.fillRect(-piece.w / 2, -piece.h / 2, piece.w, piece.h);
        ctx.restore();
      });

      confettiPieces = confettiPieces.filter(piece => piece.y < confettiCanvas.height + 40);

      if (confettiPieces.length > 0) {
        requestAnimationFrame(animateConfetti);
      } else {
        confettiAnimating = false;
        ctx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
      }
    }

    function goToNextQuestion() {
      currentQuestionIndex += 1;

      if (currentQuestionIndex >= TOTAL_QUESTIONS) {
        finishGame();
        return;
      }

      setMessage('Tap the ripest mango!', 'info');
      renderQuestion();
    }

    function finishGame() {
      updateHeader();
      progressText.textContent = `${TOTAL_QUESTIONS} / ${TOTAL_QUESTIONS} questions completed`;
      progressFill.style.width = '100%';
      setMessage('Great job! Simrit filled her basket!', 'success');
      questionTitle.textContent = 'All done!';
      questionText.textContent = 'You helped Simrit find the ripest mangoes.';
      clearMangoes();
      finishCard.classList.add('show');
      finalScoreText.textContent = `Simrit picked ${score} ripe mangoes out of ${TOTAL_QUESTIONS}!`;
      if (score === TOTAL_QUESTIONS) {
        throwConfetti(140);
      }
    }

    function handleAnswer(button, value) {
      if (!canAnswer) return;
      const question = questions[currentQuestionIndex];
      const allButtons = [...document.querySelectorAll('.mango-btn')];

      if (value === question.correct) {
        canAnswer = false;
        score += 1;
        scoreEl.textContent = score;
        setMessage('Yay! That is the ripest mango!', 'success');
        playCorrectSound();
        throwConfetti(65);

        const fall = getFallDistance(button);
        button.style.setProperty('--fall-x', `${fall.x}px`);
        button.style.setProperty('--fall-y', `${fall.y}px`);
        button.classList.add('correct');

        allButtons.forEach(btn => {
          if (btn !== button) btn.classList.add('hidden');
        });

        setTimeout(() => {
          addBasketMango();
          goToNextQuestion();
        }, 1100);
      } else {
        if (!button.classList.contains('wrong')) {
          button.classList.add('wrong');
          playWrongSound();
        } else {
          playWrongSound();
        }

        setMessage('This mango is not the ripest. Try again!', 'error');
      }

      updateHeader();
    }

    function restartGame() {
      questions = generateQuestions(TOTAL_QUESTIONS);
      currentQuestionIndex = 0;
      score = 0;
      basketFruits.innerHTML = '';
      finishCard.classList.remove('show');
      setMessage('Tap a yellow mango to begin!', 'info');
      renderQuestion();
      updateHeader();
    }

    restartBtn.addEventListener('click', restartGame);
    document.body.addEventListener('pointerdown', ensureAudio, { once: true });
    restartGame();
  </script>
</body>
</html>
